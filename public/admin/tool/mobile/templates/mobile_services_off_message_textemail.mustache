{{!
    @template tool_mobile/mobile_services_off_message_textemail

    Plain text email template for the mobile services being turned off on the site.

    Context variables required for this template:
    * heading
    * intro
    * body
    * footernote
    * buttonlabel
    * buttonurl

    Example context (json):
    {
        "heading": "Mobile app services are turned off on your site",
        "intro": "You're receiving this email because you're an administrator of My Test Moodle.",
        "body": "Students can only use the Moodle mobile app with your site when mobile services are on.",
        "footernote": "If you turned this off on purpose, you can dismiss this reminder.",
        "buttonlabel": "Enable this setting",
        "buttonurl": "https://example.com/admin/search.php?query=enablemobilewebservice"
    }
}}
{{{intro}}}

{{{heading}}}

{{{body}}}

{{{buttonlabel}}}: {{{buttonurl}}}

{{{footernote}}}
