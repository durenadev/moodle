{{!
    @template tool_mobile/mobile_user_share_message_textemail

    Plain text email template for the share of the site active users that use the Moodle app.

    Context variables required for this template:
    * heading
    * intro
    * usage
    * benefits
    * buttonlabel
    * buttonurl

    Example context (json):
    {
        "heading": "Your students are already on the Moodle mobile app",
        "intro": "You're receiving this email because you're an administrator of My Test Moodle.",
        "usage": "62% of your active users (180 people) used it this month.",
        "benefits": "With a Premium plan you can give them more: your branding in the app, unlimited course downloads, and biometric login.",
        "buttonlabel": "View plan details",
        "buttonurl": "https://example.com/admin/tool/mobile/subscription.php"
    }
}}
{{{intro}}}

{{{heading}}}

{{{usage}}}

{{{benefits}}}

{{{buttonlabel}}}: {{{buttonurl}}}
