{{!
    @template tool_mobile/mobile_user_share_message

    Rich HTML notification about the share of the site active users that use the Moodle app.

    The intro is only displayed in emails, it is hidden in Moodle pages by the d-none class.

    Context variables required for this template:
    * heading
    * iconurl
    * intro
    * usage
    * benefits
    * buttonlabel
    * buttonurl

    Example context (json):
    {
        "heading": "Your students are already on the Moodle mobile app",
        "iconurl": "/admin/tool/mobile/pix/mobileusershare_mobile.svg",
        "intro": "You're receiving this email because you're an administrator of My Test Moodle.",
        "usage": "62% of your active users (180 people) used it this month.",
        "benefits": "With a Premium plan you can give them more: your branding in the app, unlimited course downloads, and biometric login.",
        "buttonlabel": "View plan details",
        "buttonurl": "https://example.com/admin/tool/mobile/subscription.php"
    }
}}
<p class="d-none" style="margin:0 0 16px 0;color:#1f2328;font-size:14px;line-height:1.5;">{{intro}}</p>
<table class="tool-mobile-user-share-card" style="width:100%;border-radius:12px;border:1px solid #e0e0e0;border-collapse:inherit;border-spacing:0;background:#ffffff;font-size:14px;">
    <tr>
        <td style="padding:24px;border:none;">
            <table role="presentation" style="margin:0 0 12px 0;border:none;border-collapse:inherit;border-spacing:0;">
                <tr>
                    <td style="width:16px;padding:0 10px 0 0;border:none;vertical-align:middle;">
                        <img src="{{iconurl}}" alt="" aria-hidden="true" width="16" height="16" style="display:block;">
                    </td>
                    <td style="padding:0;border:none;vertical-align:middle;">
                        <h4 style="margin:0;font-weight:600;color:#1f2328;font-size:16px;line-height:1.25;">{{heading}}</h4>
                    </td>
                </tr>
            </table>
            <p style="margin:0 0 8px 0;color:#1f2328;line-height:1.5;">{{usage}}</p>
            <p style="margin:0;color:#1f2328;line-height:1.5;">{{benefits}}</p>
        </td>
    </tr>
    <tr>
        <td style="padding:12px 20px;background:#f8f9fa;border:none;border-top:1px solid #e0e0e0;border-radius:0 0 12px 12px;overflow:hidden;text-align:right;">
            <a href="{{buttonurl}}" style="display:inline-block;background:#0969da;color:#ffffff;text-decoration:none;padding:8px 10px;border-radius:12px;line-height:1.2;">{{buttonlabel}}</a>
        </td>
    </tr>
</table>
